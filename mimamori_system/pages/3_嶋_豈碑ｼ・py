# -*- coding: utf-8 -*-
"""
3_📈_比較.py
--------------
比較機能画面です。以下2種類の比較ができます。
①選択地区 VS 全地区平均
②任意の2〜4地区比較
"""

import streamlit as st

from utils.config import APP_TITLE, COL_NAME, COL_RANK, COL_SCORE, COL_AGING, COL_SINGLE_ELDERLY, COL_MEDICAL, COL_TRANSPORT
from utils.state import init_state, get_scored_data
from utils.scoring import get_city_average
from components.header import render_header, render_footer
from components.charts import build_radar_chart, build_bar_comparison, build_diff_bar_chart

st.set_page_config(page_title=f"比較 | {APP_TITLE}", page_icon="📈", layout="wide")
init_state()

st.title("📈 比較機能")
render_header()

scored_df = get_scored_data()

tab1, tab2 = st.tabs(["① 選択地区 VS 全地区平均", "② 任意の地区どうしの比較（2〜4地区）"])

INDICATOR_COLS = [COL_AGING, COL_SINGLE_ELDERLY, COL_MEDICAL, COL_TRANSPORT]

# ============================================================
# ① 選択地区 VS 全地区平均
# ============================================================
with tab1:
    target = st.selectbox("比較する地区を選んでください", options=scored_df[COL_NAME].tolist(), key="vs_avg_target")
    target_row = scored_df[scored_df[COL_NAME] == target].iloc[0]
    city_avg = get_city_average(scored_df)

    c1, c2, c3 = st.columns(3)
    c1.metric("総合スコア", f"{target_row[COL_SCORE]:.1f} 点", f"{target_row[COL_SCORE] - city_avg[COL_SCORE]:+.1f} (対平均)")
    c2.metric("順位", f"{int(target_row[COL_RANK])} 位 / {len(scored_df)}地区")
    c3.metric("優先度", target_row["優先度"])

    st.markdown("#### 指標別：平均との差")
    labels = ["高齢化率", "単身高齢者割合", "医療アクセス", "公共交通"]
    diffs = [target_row[col] - city_avg[col] for col in INDICATOR_COLS]
    st.plotly_chart(build_diff_bar_chart(labels, diffs), use_container_width=True)

    st.markdown("#### 棒グラフ比較")
    bar_values = {
        label: [target_row[col], city_avg[col]] for label, col in zip(labels, INDICATOR_COLS)
    }
    st.plotly_chart(
        build_bar_comparison([target, "全地区平均"], bar_values, title=f"{target} と全地区平均の比較"),
        use_container_width=True,
    )

    st.markdown("#### レーダーチャート比較")
    avg_row = city_avg.copy()
    st.plotly_chart(
        build_radar_chart([
            {"name": target, "row": target_row},
            {"name": "全地区平均", "row": avg_row},
        ]),
        use_container_width=True,
    )

# ============================================================
# ② 任意の2〜4地区比較
# ============================================================
with tab2:
    selected = st.multiselect(
        "比較したい地区を2〜4地区選んでください",
        options=scored_df[COL_NAME].tolist(),
        default=scored_df[COL_NAME].tolist()[:2],
        max_selections=4,
    )

    if len(selected) < 2:
        st.warning("比較には2地区以上選択してください。")
    else:
        rows = [scored_df[scored_df[COL_NAME] == name].iloc[0] for name in selected]

        st.markdown("#### 棒グラフ比較")
        labels = ["高齢化率", "単身高齢者割合", "医療アクセス", "公共交通"]
        bar_values = {
            label: [row[col] for row in rows] for label, col in zip(labels, INDICATOR_COLS)
        }
        st.plotly_chart(build_bar_comparison(selected, bar_values, title="選択地区の比較"), use_container_width=True)

        st.markdown("#### レーダーチャート比較")
        st.plotly_chart(
            build_radar_chart([{"name": name, "row": row} for name, row in zip(selected, rows)]),
            use_container_width=True,
        )

        st.markdown("#### 総合スコア比較表")
        compare_table = scored_df[scored_df[COL_NAME].isin(selected)][
            [COL_NAME, COL_RANK, COL_SCORE, "優先度"] + INDICATOR_COLS
        ].sort_values(COL_RANK)
        st.dataframe(compare_table, use_container_width=True, hide_index=True)

render_footer()
